{
  "name": "eyepiece-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "rpc:generate": "pbjs -t static-module -w es6 -o src/lib/generated/eyepiece-rpc.js ../contract/eyepiece-rpc.proto && pbts -o src/lib/generated/eyepiece-rpc.d.ts src/lib/generated/eyepiece-rpc.js"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.55.0",
    "chart.js": "^4.6.2",
    "protobufjs": "^7.5.4",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^24.0.0",
    "protobufjs-cli": "^1.1.3",
    "svelte-check": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.2.6",
    "vitest": "^3.1.1"
  }
}
